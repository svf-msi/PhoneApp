<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:f="clr-namespace:Fonts"
             xmlns:v="clr-namespace:VibSense.Views"
             xmlns:vm="clr-namespace:VibSense.ViewModels"
             xmlns:m="clr-namespace:VibSense.Models"
             x:Class="VibSense.Views.ChartsPage"
             x:DataType="vm:ChartsViewModel"
             Title="{Binding Title}"
             x:Name="chartsPage">

    <Grid>

        <Grid IsVisible="{Binding ShowChart}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--Buttons-->
            <Grid Grid.Row="0" Margin="10, 0, 10, 0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button 
                    Grid.Column="0"
                    Margin="2, 0"
                    Text="Export"
                    TextColor="White"
                    Command="{Binding ExportCommand}"/>

                <Button 
                    Grid.Column="1"
                    Margin="2, 0"
                    Text="ZoomFit"
                    TextColor="White"
                    Command="{Binding ZoomCommand}"/>

                <Button 
                    Grid.Column="2"
                    Margin="2, 0"
                    Text="Help"
                    TextColor="White"
                    Command="{Binding HelpCommand}"/>

            </Grid>

            <!--Chart-->
            <lvc:CartesianChart 
                Grid.Row="1" Grid.Column="0"
                Series="{Binding Lines}" 
                ZoomMode="{Binding ZoomMode}"
                DrawMarginFrame="{Binding DrawMarginFrame}"
                XAxes="{Binding XAxes}" 
                YAxes="{Binding YAxes}"
                EasingFunction="{x:Null}"/>

            <ScrollView Grid.Row="2" MaximumHeightRequest="200">

                <VerticalStackLayout>

                    <!--Chart settings-->
                    <Grid Margin="10, 0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!--Direction radio buttons-->
                        <Label 
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Dir:  "
                            VerticalOptions="Center"/>

                        <RadioButton 
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="-5, 0"
                            Content="Mag"
                            IsChecked="{Binding DirectionAll}"
                            GroupName="direction"
                            VerticalOptions="Center"/>

                        <RadioButton 
                            Grid.Row="0"
                            Grid.Column="2"
                            Content="{Binding LabelX}"
                            IsChecked="{Binding DirectionX}"
                            GroupName="direction"
                            VerticalOptions="Center"/>

                        <RadioButton 
                            Grid.Row="0"
                            Grid.Column="3"
                            Content="{Binding LabelY}"
                            IsChecked="{Binding DirectionY}"
                            GroupName="direction"
                            VerticalOptions="Center"/>

                        <RadioButton 
                            Grid.Row="0"
                            Grid.Column="4"
                            Content="{Binding LabelZ}"
                            IsChecked="{Binding DirectionZ}"
                            GroupName="direction"
                            VerticalOptions="Center"/>

                        <!--Type radio buttons-->
                        <Label 
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Val:  "
                            VerticalOptions="Center"/>

                        <RadioButton 
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="-5, 0"
                            Content="Dist"
                            IsChecked="{Binding TypeDisplacement}"
                            GroupName="type"/>

                        <RadioButton 
                            Grid.Row="1"
                            Grid.Column="2"
                            Content="Vel"
                            IsChecked="{Binding TypeVelocity}"
                            GroupName="type"/>

                        <RadioButton 
                            Grid.Row="1"
                            Grid.Column="3"
                            Content="Accel" 
                            Margin="0, 0, -10, 0"
                            IsChecked="{Binding TypeAcceleration}"
                            GroupName="type"/>

                        <HorizontalStackLayout
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="5">

                            <Label
                                Text="Coordinates: "
                                VerticalOptions="Center"/>

                            <RadioButton 
                                Content="Internal"
                                IsChecked="{Binding InternalCoordinates}"
                                GroupName="coordinates"/>

                            <RadioButton 
                                Content="Global" 
                                IsChecked="{Binding GlobalCoordinates}"
                                GroupName="coordinates"/>

                        </HorizontalStackLayout>

                        <HorizontalStackLayout
                            Grid.Row="3"
                            Grid.Column="0"
                            Grid.ColumnSpan="5">

                            <Label
                                Text="Vertical scale: "
                                VerticalOptions="Center"/>

                            <RadioButton 
                                Content="Linear"
                                IsChecked="{Binding LinearChart}"
                                GroupName="scale"/>

                            <RadioButton 
                                Content="Log" 
                                IsChecked="{Binding LogChart}"
                                GroupName="scale"/>

                        </HorizontalStackLayout>

                    </Grid>

                    <!--Chart data-->
                    <CollectionView ItemsSource="{Binding Charts}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="{x:Type m:ChartData}">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItemView 
                                                 Command="{Binding Source={x:Reference chartsPage}, Path=BindingContext.DeleteCommand}"
                                                 CommandParameter="{Binding .}">
                                                <Border BackgroundColor="Red" Margin="5,0">
                                                    <Image Source="{StaticResource IconDelete}" VerticalOptions="Center" WidthRequest="32" Margin="-3, 0"/>
                                                </Border>
                                            </SwipeItemView>
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Border StrokeThickness="1" Stroke="Gray" Margin="15, 1">
                                        <Grid ColumnDefinitions="*, Auto, Auto">
                                            <Label 
                                                Grid.Column="0" 
                                                Margin="0, -10"
                                                Text="{Binding Name}" 
                                                LineBreakMode="TailTruncation"
                                                VerticalOptions="Center"/>
                                            <BoxView 
                                                Grid.Column="1" 
                                                HeightRequest="3" 
                                                WidthRequest="30"
                                                Color="{Binding Color}" 
                                                VerticalOptions="Center"/>
                                            <CheckBox 
                                                Grid.Column="2" 
                                                Margin="0, -15"
                                                IsChecked="{Binding Selected}"
                                                VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                </VerticalStackLayout>

            </ScrollView>

        </Grid>

        <Grid IsVisible="{Binding ShowHelp}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="5"
                Text="Help"
                HorizontalOptions="Center"/>

            <ScrollView 
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="10">
                <Label 
                    Text="{Binding HelpText}"
                    LineBreakMode="WordWrap"/>
            </ScrollView>

            <Button 
                Grid.Row="5"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Text="Back"
                Command="{Binding GoBackCommand}"
                TextColor="White"
                Margin="10"
                Padding="50, 0"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
        </Grid>

    </Grid>

</ContentPage>