<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:v="clr-namespace:VibSense.Views"
             xmlns:vm="clr-namespace:VibSense.ViewModels"
             x:Class="VibSense.Views.LivePage"
             x:DataType="vm:LiveViewModel"
             Title="Live Chart">
    
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!--Chart-->
        <lvc:CartesianChart 
            Grid.Row="2" Grid.Column="0"
            Series="{Binding Lines}" 
            ZoomMode="{Binding ZoomMode}"
            DrawMarginFrame="{Binding DrawMarginFrame}"
            XAxes="{Binding XAxes}" 
            YAxes="{Binding YAxes}"
            EasingFunction="{x:Null}"/>

        <!--Top buttons-->
        <Grid Grid.Row="0" Margin="10, 0, 10,  -10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button 
                Grid.Column="0"
                Margin="1, 0"
                Text="Help"
                TextColor="White"
                Command="{Binding HelpCommand}"/>

            <Button 
                Grid.Column="1"
                Margin="1, 0"
                Text="Zoom"
                TextColor="White"
                Command="{Binding ZoomCommand}"/>

            <Button 
                Grid.Column="2"
                Margin="1, 0"
                IsEnabled="{Binding HasData}"
                Text="Clear"
                TextColor="White"
                Command="{Binding ClearCommand}"/>

            <Button 
                Grid.Column="3"
                Margin="1, 0"
                IsEnabled="{Binding HasData}"
                Text="Save"
                TextColor="White"
                Command="{Binding SaveCommand}"/>
        </Grid>

        <Grid Grid.Row="3" Margin="20, 10">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--Direction radio buttons-->
            <Label 
                Grid.Row="0"
                Grid.Column="0"
                Text="Dir.:"
                VerticalOptions="Center"/>

            <RadioButton 
                Grid.Row="0"
                Grid.Column="1"
                Margin="-5, 0"
                Content="Mag"
                IsChecked="{Binding DirectionAll}"
                GroupName="direction"
                VerticalOptions="Center"/>

            <RadioButton 
                Grid.Row="0"
                Grid.Column="2"
                Content="X"
                IsChecked="{Binding DirectionX}"
                GroupName="direction"
                VerticalOptions="Center"/>

            <RadioButton 
                Grid.Row="0"
                Grid.Column="3"
                Content="Y"
                IsChecked="{Binding DirectionY}"
                GroupName="direction"
                VerticalOptions="Center"/>

            <RadioButton 
                Grid.Row="0"
                Grid.Column="4"
                Content="Z"
                IsChecked="{Binding DirectionZ}"
                GroupName="direction"
                VerticalOptions="Center"/>

            <!--Type radio buttons-->
            <Label 
                Grid.Row="1"
                Grid.Column="0"
                Text="Type:"
                VerticalOptions="Center"/>

            <RadioButton 
                Grid.Row="1"
                Grid.Column="1"
                Margin="-5, 0"
                Content="D"
                IsChecked="{Binding TypeDisplacement}"
                GroupName="type"/>

            <RadioButton 
                Grid.Row="1"
                Grid.Column="2"
                Content="V"
                IsChecked="{Binding TypeVelocity}"
                GroupName="type"/>

            <RadioButton 
                Grid.Row="1"
                Grid.Column="3"
                Content="A"
                IsChecked="{Binding TypeAcceleration}"
                GroupName="type"/>

        </Grid>

        <Button 
            Grid.Row="4" Grid.Column="0"
            Text="Press and Hold to Measure"
            TextColor="White"
            Pressed="Button_Pressed"
            Released="Button_Released"
            Margin="10"/>

    </Grid>
</ContentPage>