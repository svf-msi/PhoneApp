<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.Maui;assembly=LiveChartsCore.SkiaSharpView.Maui"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:f="clr-namespace:Fonts"
             xmlns:v="clr-namespace:VibSense.Views"
             xmlns:vm="clr-namespace:VibSense.ViewModels"
             x:Class="VibSense.Views.LivePage"
             x:DataType="vm:LiveViewModel"
             Title="Live Chart">

    <ContentPage.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentPage.Resources>

    <Grid>

        <Grid IsVisible="{Binding ShowChart}">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--Chart-->
            <lvc:CartesianChart 
                Grid.Row="2" Grid.Column="0"
                Series="{Binding Lines}" 
                ZoomMode="{Binding ZoomMode}"
                DrawMarginFrame="{Binding DrawMarginFrame}"
                XAxes="{Binding XAxes}" 
                YAxes="{Binding YAxes}"
                EasingFunction="{x:Null}"/>

            <!--Top buttons-->
            <Grid Grid.Row="0" Margin="10, 0, 10,  -10">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button 
                Grid.Column="0"
                Margin="1, 0"
                IsEnabled="{Binding HasData}"
                Text="{x:Static f:FluentUI.save_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                TextColor="White"
                Command="{Binding SaveCommand}"/>

                <Button 
                Grid.Column="1"
                Margin="1, 0"
                IsEnabled="{Binding HasData}"
                Text="{x:Static f:FluentUI.delete_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                TextColor="White"
                Command="{Binding ClearCommand}"/>

                <Button 
                Grid.Column="2"
                Margin="1, 0"
                IsEnabled="{Binding HasData}"
                Text="{x:Static f:FluentUI.zoom_fit_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                TextColor="White"
                Command="{Binding ZoomCommand}"/>

                <Button 
                Grid.Column="3"
                Margin="1, 0"
                Text="{x:Static f:FluentUI.settings_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                TextColor="White"
                Command="{Binding SettingsCommand}"/>

                <Button 
                Grid.Column="4"
                Margin="1, 0"
                Text="{x:Static f:FluentUI.question_circle_24_regular}"
                FontFamily="{x:Static f:FluentUI.FontFamily}"
                TextColor="White"
                Command="{Binding HelpCommand}"/>

            </Grid>

            <Grid Grid.Row="3" Margin="20, 10">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!--Direction radio buttons-->
                <Label 
                Grid.Row="0"
                Grid.Column="0"
                Text="Dir:  "
                VerticalOptions="Center"/>

                <RadioButton 
                Grid.Row="0"
                Grid.Column="1"
                Margin="-5, 0"
                Content="Mag"
                IsChecked="{Binding DirectionAll}"
                GroupName="direction"
                VerticalOptions="Center"/>

                <RadioButton 
                Grid.Row="0"
                Grid.Column="2"
                Content="X"
                IsChecked="{Binding DirectionX}"
                GroupName="direction"
                VerticalOptions="Center"/>

                <RadioButton 
                Grid.Row="0"
                Grid.Column="3"
                Content="Y"
                IsChecked="{Binding DirectionY}"
                GroupName="direction"
                VerticalOptions="Center"/>

                <RadioButton 
                Grid.Row="0"
                Grid.Column="4"
                Content="Z"
                IsChecked="{Binding DirectionZ}"
                GroupName="direction"
                VerticalOptions="Center"/>

                <!--Type radio buttons-->
                <Label 
                Grid.Row="1"
                Grid.Column="0"
                Text="Val:  "
                VerticalOptions="Center"/>

                <RadioButton 
                Grid.Row="1"
                Grid.Column="1"
                Margin="-5, 0"
                Content="Dist"
                IsChecked="{Binding TypeDisplacement}"
                GroupName="type"/>

                <RadioButton 
                Grid.Row="1"
                Grid.Column="2"
                Content="Vel"
                IsChecked="{Binding TypeVelocity}"
                GroupName="type"/>

                <RadioButton 
                Grid.Row="1"
                Grid.Column="3"
                Content="Accel" 
                Margin="0, 0, -10, 0"
                IsChecked="{Binding TypeAcceleration}"
                GroupName="type"/>

            </Grid>

            <Button 
                Grid.Row="4" Grid.Column="0"
                IsVisible="{Binding ButtonLock, Converter={StaticResource InvertedBoolConverter}}"
                Text="Press and Hold to Measure"
                TextColor="White"
                BackgroundColor="Green"
                Pressed="Button_Pressed"
                Released="Button_Released"
                Margin="10">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                        Binding="{Binding IsRecording}"
                        Value="True">
                        <Setter Property="BackgroundColor" Value="Red" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button 
                Grid.Row="4" Grid.Column="0"
                IsVisible="{Binding ButtonLock}"
                Text="Press to Start/Stop"
                TextColor="White"
                BackgroundColor="Green"
                Command="{Binding StartStopCommand}"
                Margin="10">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                        Binding="{Binding IsRecording}"
                        Value="False">
                        <Setter Property="Text" Value="Press to Start Measurement" />
                    </DataTrigger>

                    <DataTrigger TargetType="Button"
                        Binding="{Binding IsRecording}"
                        Value="True">
                        <Setter Property="Text" Value="Press to Stop Measurement" />
                    </DataTrigger>

                    <DataTrigger TargetType="Button"
                        Binding="{Binding IsRecording}"
                        Value="True">
                        <Setter Property="BackgroundColor" Value="Red" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

        </Grid>

        <Grid IsVisible="{Binding ShowSaving}" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="5"
                Text="Saving Chart"
                HorizontalOptions="Center"/>

            <HorizontalStackLayout
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2">
                <Label 
                    Text="Select: "
                    VerticalOptions="Center"/>
                <RadioButton
                    Content="New"
                    IsChecked="{Binding UseNew}"/>
                <RadioButton
                    Content="Existing"
                    IsChecked="{Binding UseExisting}"/>
            </HorizontalStackLayout>

            <Label 
                Grid.Row="2"
                Grid.Column="0"
                Text="Set Name: "
                VerticalOptions="Center"/>

            <Picker
                Grid.Row="2"
                Grid.Column="1"
                IsVisible="{Binding UseExisting}"
                ItemsSource="{Binding ExistingSets}"
                SelectedIndex="{Binding ExistingSetIndex}"
                VerticalOptions="Center"/>

            <Entry
                Grid.Row="2"
                Grid.Column="1"
                IsVisible="{Binding UseNew}"
                Text="{Binding NewSetName}"
                VerticalOptions="Center"/>

            <Label 
                Grid.Row="3"
                Grid.Column="0"
                Text="Chart Name: "
                VerticalOptions="Center"/>

            <Entry
                Grid.Row="3"
                Grid.Column="1"
                Text="{Binding NewChartName}"
                VerticalOptions="Center"/>

            <Button 
                Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Text="Save"
                Command="{Binding SaveChartCommand}"
                TextColor="White"
                Padding="50, 0"
                Margin="10, 20"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>

            <Button 
                Grid.Row="6"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Text="Back"
                Command="{Binding GoBackCommand}"
                TextColor="White"
                Padding="50, 0"
                Margin="10"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
        </Grid>

        <Grid IsVisible="{Binding ShowSettings}" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="5"
                Text="Settings"
                HorizontalOptions="Center"/>

            <HorizontalStackLayout
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2">
                <Label 
                    Text="Units: "
                    VerticalOptions="Center"/>
                <RadioButton
                    Content="Imperial"
                    IsChecked="{Binding IsImperial}"/>
                <RadioButton
                    Content="Metric"
                    IsChecked="{Binding IsMetric}"/>
            </HorizontalStackLayout>

            <Label 
                Grid.Row="2"
                Grid.Column="0"
                Text="Min duration(sec): "
                VerticalOptions="Center"/>

            <Entry
                Grid.Row="2"
                Grid.Column="1"
                Text="{Binding MinDuration}"
                Keyboard="Numeric" 
                VerticalOptions="Center"/>

            <Label 
                Grid.Row="3"
                Grid.Column="0"
                Text="Max duration(sec): "
                VerticalOptions="Center"/>

            <Entry
                Grid.Row="3"
                Grid.Column="1"
                Text="{Binding MaxDuration}"
                Keyboard="Numeric" 
                VerticalOptions="Center"/>

            <HorizontalStackLayout 
                Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="2">

                <CheckBox 
                    IsChecked="{Binding ButtonLock}"
                    VerticalOptions="Center"/>

                <Label 
                    Text="Lock start/stop button"
                    VerticalOptions="Center"/>

            </HorizontalStackLayout>

            <Button 
                Grid.Row="6"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Text="Back"
                Command="{Binding GoBackCommand}"
                TextColor="White"
                Padding="50, 0"
                Margin="10"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
        </Grid>

        <Grid IsVisible="{Binding ShowHelp}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="5"
                Text="Help"
                HorizontalOptions="Center"/>

            <ScrollView 
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Margin="10">
                <Label 
                    Text="{Binding HelpText}"
                    LineBreakMode="WordWrap"/>
            </ScrollView>

            <Button 
                Grid.Row="5"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Text="Back"
                Command="{Binding GoBackCommand}"
                TextColor="White"
                Margin="10"
                Padding="50, 0"
                HorizontalOptions="Center"
                VerticalOptions="Center"/>
        </Grid>

    </Grid>
    
</ContentPage>