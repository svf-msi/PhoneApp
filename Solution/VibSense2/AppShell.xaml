<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MicroVue.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="clr-namespace:MicroVue.Views"
    xmlns:vm="clr-namespace:MicroVue.ViewModels"
    x:DataType="vm:AppShellViewModel"
    Title="MicroVue">

    <Shell.Resources>
        <Style Class="FlyoutItemLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
        </Style>
    </Shell.Resources>

    <ShellContent
        Title="About"
        Icon="{StaticResource IconInfo}"
        ContentTemplate="{DataTemplate v:AboutPage}"
        Route="AboutPage" />

    <ShellContent
        Title="Main"
        Icon="{StaticResource IconHome}"
        ContentTemplate="{DataTemplate v:MainPage}"
        Route="MainPage" />

</Shell>
