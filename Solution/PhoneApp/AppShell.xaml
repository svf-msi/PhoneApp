<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MicroVue.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:v="clr-namespace:MicroVue.Views"
    Title="MicroVue">

    <Shell.Resources>
        <Style Class="FlyoutItemLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource SecondaryDarkText}}" />
        </Style>
    </Shell.Resources>

    <ShellContent
        Title="Scenes"
        Icon="{StaticResource IconScenes}"
        ContentTemplate="{DataTemplate v:ScenesPage}"
        Route="ScenesPage" />

    <ShellContent
        Title="Import"
        Icon="{StaticResource IconVideoAdd}"
        ContentTemplate="{DataTemplate v:ImportPage}"
        Route="ImportPage" />

    <ShellContent
        Title="About"
        Icon="{StaticResource IconInfo}"
        ContentTemplate="{DataTemplate v:AboutPage}"
        Route="AboutPage" />

</Shell>
