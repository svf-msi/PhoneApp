<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:f="clr-namespace:Fonts"
             xmlns:m="clr-namespace:MicroVue.Models"
             xmlns:vm="clr-namespace:MicroVue.ViewModels"
             xmlns:v="clr-namespace:MicroVue.Views"
             x:Class="MicroVue.Views.MainPanel"
             x:DataType="vm:AnalysisViewModel">

    <Grid RowDefinitions="Auto, *, Auto" ColumnDefinitions="Auto">
        
        <!--Regions-->
        <Grid Grid.Row="1" RowDefinitions="Auto, *" ColumnDefinitions="*" Margin="5">

            <Label Grid.Row="0" Text=" Regions:" Margin="5"/>

            <ScrollView Grid.Row="1" Margin="5">

                <CollectionView ItemsSource="{Binding Scene.Regions}" >
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="m:Region">
                            <Border StrokeThickness="1" Stroke="Gray" Margin="10, 1">
                                <Grid ColumnDefinitions="*">
                                    <Label Text="{Binding Name}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

            </ScrollView>
        </Grid>
        
    </Grid>

</ContentView>
