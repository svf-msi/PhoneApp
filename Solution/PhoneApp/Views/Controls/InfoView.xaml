<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:f="clr-namespace:Fonts"
             xmlns:m="clr-namespace:MicroVue.Models"
             xmlns:vm="clr-namespace:MicroVue.ViewModels"
             xmlns:v="clr-namespace:MicroVue.Views"
             x:Class="MicroVue.Views.InfoView"
             x:DataType="vm:AnalysisViewModel">
    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, *" ColumnDefinitions="Auto, *">

        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Field of View:"/>

        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="1" Text="Width: " VerticalOptions="Center"/>
        <Entry Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="1" FontSize="16" Keyboard="Numeric" Margin="0, -5" 
               Text="{Binding Scene.FovWidth}" VerticalOptions="Center"/>

        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="1" Text="Height: " VerticalOptions="Center"/>
        <Entry Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="1" FontSize="16" Keyboard="Numeric" Margin="0, -5" 
               Text="{Binding Scene.FovHeight}" VerticalOptions="Center"/>

        <Label Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="1" Text="Units: " VerticalOptions="Center"/>
        <Picker Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="1" FontSize="16" VerticalOptions="Center" Margin="0, -5" 
                ItemsSource="{Binding Units}" SelectedItem="{Binding Scene.DistanceUnits}"/>

        <Label Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Text="Video Info:" Margin="0, 5"/>

        <Label Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="1" Text="Size: "/>
        <Label Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="1" Text="{Binding Resolution}"/>

        <Label Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="1" Text="Angle: "/>
        <Label Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="1" Text="{Binding MediaRotation}"/>

        <Label Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="1" Text="Length: "/>
        <Label Grid.Row="8" Grid.Column="1" Grid.ColumnSpan="1" Text="{Binding MediaLength}"/>

    </Grid>
</ContentView>
