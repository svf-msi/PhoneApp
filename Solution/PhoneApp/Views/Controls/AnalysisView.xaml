<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:f="clr-namespace:Fonts"
             xmlns:m="clr-namespace:MicroVue.Models"
             xmlns:vm="clr-namespace:MicroVue.ViewModels"
             xmlns:v="clr-namespace:MicroVue.Views"
             xmlns:lib="clr-namespace:StandardLib;assembly=StandardLib"
             x:DataType="vm:AnalysisViewModel"
             x:Class="MicroVue.Views.AnalysisView">

    <ContentView.Resources>
        <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
    </ContentView.Resources>

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto, *" ColumnDefinitions="Auto, *">

        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="Analysis results:"/>

        <ScrollView Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" >
            <CollectionView ItemsSource="{Binding Scene.Targets}" SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="{x:Type lib:Target}">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="{Binding Name}" LineBreakMode="TailTruncation"/>
                            <Label Grid.Column="1" Text="{Binding Completion, StringFormat='{0}%'}" 
                                   TextColor="White" BackgroundColor="Green" IsVisible="{Binding IsComplete}"/>
                            <Label Grid.Column="1" Text="{Binding Completion, StringFormat='{0}%'}" 
                                   TextColor="White" BackgroundColor="Red" 
                                   IsVisible="{Binding IsComplete, Converter={StaticResource InvertedBoolConverter}}"/>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ScrollView>

        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding AnalysisResults}"/>

    </Grid>
    
</ContentView>
