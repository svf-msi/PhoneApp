<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MicroVue.ViewModels"
             xmlns:v="clr-namespace:MicroVue.Views"
             x:Class="MicroVue.Views.MainView"
             x:DataType="vm:AnalysisViewModel">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" IsClippedToBounds="True">
            <v:PanZoomContainer>
                <Grid IsClippedToBounds="True">
                    <toolkit:MediaElement Source="{Binding Source}" 
                          ShouldAutoPlay="False" Aspect="AspectFit"
                          ShouldShowPlaybackControls="False" 
                          PositionChanged="OnMediaPositionChanged"
                          x:Name="player"/>
                </Grid>
            </v:PanZoomContainer>
        </Grid>

        <Label Grid.Row="0"
            Text="{Binding SceneName}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" 
            LineBreakMode="TailTruncation"/>

        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Row="2" Margin="5"
                    Text="Play" Clicked="OnPlayPauseButtonClicked">
                <Button.Triggers>
                    <DataTrigger TargetType="Button"
                    Binding="{Binding CurrentState, Source={x:Reference player}}"
                    Value="{x:Static toolkit:MediaElementState.Playing}">
                        <Setter Property="Text"
                                Value="Pause" />
                    </DataTrigger>
                    <DataTrigger TargetType="Button"
                    Binding="{Binding CurrentState, Source={x:Reference player}}"
                    Value="{x:Static toolkit:MediaElementState.Buffering}">
                        <Setter Property="IsEnabled"
                                Value="False" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Slider Grid.Column="1" Margin="5" VerticalOptions="Center" x:Name="slider"
                    Minimum="0" DragStarted="OnSliderDragStarted" DragCompleted="OnSliderDragCompleted"/>

        </Grid>

    </Grid>
</ContentView>
