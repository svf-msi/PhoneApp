<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:vm="clr-namespace:MicroVue.ViewModels"
             xmlns:v="clr-namespace:MicroVue.Views"
             x:Class="MicroVue.Views.MainView"
             x:DataType="vm:AnalysisViewModel">

    <ContentView.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBool" />
        </ResourceDictionary>
    </ContentView.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid IsClippedToBounds="True" Grid.Row="1" Margin="0" HorizontalOptions="Fill">
            <v:PanZoomContainer Margin="10" HorizontalOptions="Center">
                <Grid>
                    <Image Source="{Binding Image}" Rotation="{Binding Rotation}"/>
                </Grid>
            </v:PanZoomContainer>
        </Grid>

        <Label 
            Grid.Row="0" Margin="10"
            Text="{Binding SceneName}"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />

        <Grid Grid.Row="2" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ImageButton Grid.Column="0" Source="{StaticResource IconPlay}" Command="{Binding PlayPauseCommand}" 
                         Margin="5" IsVisible="{Binding IsPlaying, Converter={StaticResource InvertedBool}}"/>
            <ImageButton Grid.Column="0" Source="{StaticResource IconPause}" Command="{Binding PlayPauseCommand}" 
                         Margin="5" IsVisible="{Binding IsPlaying}"/>
            
        </Grid>

    </Grid>
</ContentView>
