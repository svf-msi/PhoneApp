<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:f="clr-namespace:Fonts"
             xmlns:lib="clr-namespace:StandardLib;assembly=StandardLib"
             xmlns:m="clr-namespace:MicroVue.Models"
             xmlns:vm="clr-namespace:MicroVue.ViewModels"
             xmlns:v="clr-namespace:MicroVue.Views"
             x:DataType="vm:AnalysisViewModel"
             x:Name="videoView"
             x:Class="MicroVue.Views.VideoView">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!--Video-->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Grid.Row="0" Padding="3"
                Text="{Binding SelectedFoi.Name}"
                VerticalOptions="Center" 
                HorizontalOptions="Center" 
                LineBreakMode="TailTruncation"/>

            <Grid Grid.Row="1" IsClippedToBounds="True">
                <v:PanZoomContainer>

                    <AbsoluteLayout IsClippedToBounds="True">

                        <!--Video player-->
                        <toolkit:MediaElement Source="{Binding FoiVideoSource}"
                            ShouldAutoPlay="False" 
                            ShouldLoopPlayback="True"
                            ShouldShowPlaybackControls="False" 
                            AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
                            AbsoluteLayout.LayoutFlags="All" 
                            x:Name="player2"/>

                    </AbsoluteLayout>

                </v:PanZoomContainer>
            </Grid>

        </Grid>

        <!--Side panel-->
        <v:VideoPanel Grid.Row="0" Grid.Column="1" x:Name="sidePanel" 
                 HorizontalOptions="Fill" MinimumWidthRequest="250"
                 IsVisible="False"  BindingContext="{Binding .}"/>

        <!--Bottom panel-->
        <v:VideoPanel Grid.Row="1" Grid.Column="0" x:Name="bottomPanel" 
                 HorizontalOptions="Fill" MaximumHeightRequest="240"
                 IsVisible="True"  BindingContext="{Binding .}"/>

    </Grid>
    
</ContentView>
